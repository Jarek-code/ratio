# Servidor
IP=0.0.0.0
PORT=8080
RUST_LOG=info

# Base de datos (Supabase). La contraseña NO se versiona: en local va en .env, en Render como
# variable de entorno del servicio. Si tiene caracteres especiales, percent-encódelos.
#
# Conexión directa (solo si el proyecto tiene IPv4; los nuevos son solo IPv6):
#   postgresql://postgres:CONTRASENA@db.zhmhcpyruhmmyeqluuzh.supabase.co:5432/postgres
#
# Session pooler: es la que funciona desde Render, que no tiene salida IPv6.
# Cópiala del panel: Connect → Session pooler.
#   postgresql://postgres.zhmhcpyruhmmyeqluuzh:CONTRASENA@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://ratio:ratio@127.0.0.1:5432/ratio

# Aplicar migrations/ al arrancar. Las dos primeras ya están aplicadas en Supabase; con true
# se aplica la de parches, que es idempotente y puede correr sobre una base que ya los tenga.
MIGRACIONES_AL_ARRANCAR=false

# Supabase Auth: acceso y alta de cuentas. La dirección es la del proyecto y la clave es la
# pública que da Ajustes → API: la `anon` de siempre o la nueva `publishable` (sb_publishable_…),
# que va en la misma cabecera. La contraseña de cada persona la guarda Supabase hasheada en
# auth.users; el servidor solo reenvía las credenciales y verifica el token que devuelve.
#   SUPABASE_URL=https://zhmhcpyruhmmyeqluuzh.supabase.co
#   SUPABASE_ANON_KEY=sb_publishable_…
SUPABASE_URL=
SUPABASE_ANON_KEY=
