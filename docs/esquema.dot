// Diagrama entidad-relación de migrations/20261019000000_databaseRATIO.sql (PK = llave primaria, FK = llave foránea, ? = admite NULL)
// Render: dot -Tsvg docs/esquema.dot -o docs/esquema.svg
digraph esquema {
    rankdir=LR;
    node [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge [arrowhead=crow, arrowtail=tee, dir=both, color="#555", fontsize=9];
    auth_users -> usuario [label="id", arrowhead=tee];
    auth_users [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="lightgrey"><b>auth.users</b> (Supabase)</td></tr></table>>];
    comentario [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>comentario</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">autor_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">respuesta_a <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">texto <font color="#666">text</font></td></tr><tr><td align="left">componente_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">paso_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">propuesta <font color="#666">double precision</font> ?</td></tr><tr><td align="left">oculto <font color="#666">boolean</font></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    componente_receta [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>componente_receta</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">posicion <font color="#666">smallint</font></td></tr><tr><td align="left">ingrediente_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">nombre <font color="#666">text</font></td></tr><tr><td align="left">graduacion_pct <font color="#666">double precision</font></td></tr><tr><td align="left">color <font color="#666">text</font> ?</td></tr><tr><td align="left">cantidad <font color="#666">double precision</font></td></tr><tr><td align="left">unidad <font color="#666">text</font></td></tr><tr><td align="left">dilucion <font color="#666">boolean</font></td></tr></table>>];
    guardado [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>guardado</b></td></tr><tr><td align="left">usuario_id <font color="#666">uuid</font> <b>PK</b> <b>FK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>PK</b> <b>FK</b></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    ingrediente [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>ingrediente</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">nombre <font color="#666">text</font></td></tr><tr><td align="left">unidad <font color="#666">text</font></td></tr><tr><td align="left">graduacion_pct <font color="#666">double precision</font></td></tr><tr><td align="left">color <font color="#666">text</font> ?</td></tr><tr><td align="left">es_dilucion <font color="#666">boolean</font></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    paso [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>paso</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">posicion <font color="#666">smallint</font></td></tr><tr><td align="left">instruccion <font color="#666">text</font></td></tr><tr><td align="left">temporizador_s <font color="#666">integer</font> ?</td></tr></table>>];
    preparacion [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>preparacion</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">usuario_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">me_salio <font color="#666">boolean</font></td></tr><tr><td align="left">gusto <font color="#666">smallint</font> ?</td></tr><tr><td align="left">duracion_s <font color="#666">integer</font> ?</td></tr><tr><td align="left">creada_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    receta [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>receta</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">autor_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">receta_origen_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">nombre <font color="#666">text</font></td></tr><tr><td align="left">tipo <font color="#666">text</font></td></tr><tr><td align="left">vaso_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">capacidad_ml <font color="#666">double precision</font> ?</td></tr><tr><td align="left">fotos_rutas <font color="#666">text[]</font></td></tr><tr><td align="left">equipo <font color="#666">text[]</font></td></tr><tr><td align="left">publicada_en <font color="#666">timestamp with time zone</font> ?</td></tr><tr><td align="left">oculta <font color="#666">boolean</font></td></tr><tr><td align="left">creada_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    reporte [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>reporte</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">reportante_id <font color="#666">uuid</font> <b>FK</b></td></tr><tr><td align="left">receta_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">comentario_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">motivo <font color="#666">text</font></td></tr><tr><td align="left">detalle <font color="#666">text</font> ?</td></tr><tr><td align="left">estado <font color="#666">text</font></td></tr><tr><td align="left">moderador_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr><tr><td align="left">resuelto_en <font color="#666">timestamp with time zone</font> ?</td></tr></table>>];
    seguimiento [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>seguimiento</b></td></tr><tr><td align="left">seguidor_id <font color="#666">uuid</font> <b>PK</b> <b>FK</b></td></tr><tr><td align="left">seguido_id <font color="#666">uuid</font> <b>PK</b> <b>FK</b></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    usuario [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>usuario</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b> <b>FK</b></td></tr><tr><td align="left">alias <font color="#666">text</font></td></tr><tr><td align="left">mayor_de_edad <font color="#666">boolean</font></td></tr><tr><td align="left">avatar_ruta <font color="#666">text</font> ?</td></tr><tr><td align="left">modo_uso <font color="#666">text</font> ?</td></tr><tr><td align="left">nivel <font color="#666">text</font> ?</td></tr><tr><td align="left">intereses <font color="#666">text[]</font></td></tr><tr><td align="left">equipo <font color="#666">text[]</font></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    vaso [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#FFD8A8"><b>vaso</b></td></tr><tr><td align="left">id <font color="#666">uuid</font> <b>PK</b></td></tr><tr><td align="left">autor_id <font color="#666">uuid</font> <b>FK</b> ?</td></tr><tr><td align="left">nombre <font color="#666">text</font></td></tr><tr><td align="left">capacidad_ml <font color="#666">double precision</font></td></tr><tr><td align="left">radio_boca <font color="#666">double precision</font></td></tr><tr><td align="left">radio_fondo <font color="#666">double precision</font></td></tr><tr><td align="left">altura <font color="#666">double precision</font></td></tr><tr><td align="left">pared <font color="#666">double precision</font></td></tr><tr><td align="left">borde <font color="#666">double precision</font></td></tr><tr><td align="left">tallo <font color="#666">double precision</font></td></tr><tr><td align="left">asa <font color="#666">text</font> ?</td></tr><tr><td align="left">plato <font color="#666">boolean</font></td></tr><tr><td align="left">creado_en <font color="#666">timestamp with time zone</font></td></tr></table>>];
    // padre -> hijo (la pata de gallo marca el lado de muchas filas)
    comentario -> comentario [label="respuesta_a"];
    comentario -> reporte [label="comentario_id"];
    componente_receta -> comentario [label="componente_id"];
    ingrediente -> componente_receta [label="ingrediente_id"];
    paso -> comentario [label="paso_id"];
    receta -> comentario [label="receta_id"];
    receta -> componente_receta [label="receta_id"];
    receta -> guardado [label="receta_id"];
    receta -> paso [label="receta_id"];
    receta -> preparacion [label="receta_id"];
    receta -> receta [label="receta_origen_id"];
    receta -> reporte [label="receta_id"];
    usuario -> comentario [label="autor_id"];
    usuario -> guardado [label="usuario_id"];
    usuario -> preparacion [label="usuario_id"];
    usuario -> receta [label="autor_id"];
    usuario -> reporte [label="moderador_id"];
    usuario -> reporte [label="reportante_id"];
    usuario -> seguimiento [label="seguido_id"];
    usuario -> seguimiento [label="seguidor_id"];
    usuario -> vaso [label="autor_id"];
    vaso -> receta [label="vaso_id"];
}
